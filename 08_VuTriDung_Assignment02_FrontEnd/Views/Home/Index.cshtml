@model IEnumerable<_08_VuTriDung_Assignment02_FrontEnd.Models.NewsArticleViewModel>
@{
    ViewData["Title"] = "Latest News";
    var categories = ViewBag.Categories as List<_08_VuTriDung_Assignment02_FrontEnd.Models.CategoryViewModel> ?? new();
    var currentSearch = ViewBag.CurrentSearch as string;
    short? currentCat = ViewBag.CurrentCategory as short?;
}

<div class="row mb-4 align-items-center">
    <div class="col-md-7">
        <h1 class="fw-bold mb-1" style="font-size: 1.85rem;">University News Portal</h1>
        <p class="text-muted mb-0">Discover the latest announcements, research breakthroughs, and campus events.</p>
    </div>
    <div class="col-md-5 mt-3 mt-md-0">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <input type="text" name="search" class="form-control rounded-pill" placeholder="Search news..." value="@currentSearch" />
            <select name="categoryId" class="form-select rounded-pill" style="max-width: 170px;" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.CategoryID" selected="@(currentCat == cat.CategoryID)">@cat.CategoryName</option>
                }
            </select>
            <button type="submit" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-search"></i>
            </button>
            @if (!string.IsNullOrEmpty(currentSearch) || currentCat.HasValue)
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Clear Filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center text-muted">
        <i class="bi bi-newspaper fs-1 mb-2"></i>
        <h5>No news articles found</h5>
        <p class="small mb-0">Try changing your search terms or category filter.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition-all bg-white d-flex flex-column">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1 small fw-semibold">
                                @(string.IsNullOrEmpty(item.CategoryName) ? "General" : item.CategoryName)
                            </span>
                            <span class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>@(item.CreatedDate?.ToString("MMM dd, yyyy") ?? "N/A")
                            </span>
                        </div>

                        <h5 class="card-title fw-bold text-dark mt-2 mb-2 line-clamp-2">
                            <a asp-action="Detail" asp-route-id="@item.NewsArticleID" class="text-decoration-none text-dark hover-primary">
                                @item.Headline
                            </a>
                        </h5>

                        <p class="card-text text-muted small flex-grow-1 line-clamp-3">
                            @(string.IsNullOrEmpty(item.NewsContent) ? item.NewsTitle : item.NewsContent)
                        </p>

                        @if (item.Tags != null && item.Tags.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var tag in item.Tags.Take(4))
                                {
                                    <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small">
                                        #@tag.TagName
                                    </span>
                                }
                            </div>
                        }

                        <div class="pt-3 border-top mt-auto d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                <i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(item.CreatedByName) ? "Author" : item.CreatedByName)
                            </span>
                            <a asp-action="Detail" asp-route-id="@item.NewsArticleID" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                Read More <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .hover-shadow:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1) !important;
    }
    .transition-all {
        transition: all 0.25s ease-in-out;
    }
    .hover-primary:hover {
        color: #0284c7 !important;
    }
</style>
