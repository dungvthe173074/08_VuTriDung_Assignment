@model _08_VuTriDung_Assignment02_FrontEnd.Models.NewsArticleViewModel
@{
    ViewData["Title"] = Model.Headline;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-4">
            <i class="bi bi-arrow-left me-1"></i> Back to News Feed
        </a>

        <article class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1.5 fw-semibold">
                    @(string.IsNullOrEmpty(Model.CategoryName) ? "General News" : Model.CategoryName)
                </span>
                <span class="text-muted small">
                    <i class="bi bi-clock me-1"></i>Posted on @(Model.CreatedDate?.ToString("MMMM dd, yyyy") ?? "N/A")
                </span>
                @if (Model.ModifiedDate.HasValue && Model.ModifiedDate != Model.CreatedDate)
                {
                    <span class="text-muted small ms-2">
                        (Updated: @Model.ModifiedDate.Value.ToString("MMM dd, yyyy"))
                    </span>
                }
            </div>

            <h1 class="fw-bold mb-3 display-6 text-dark">@Model.Headline</h1>

            @if (!string.IsNullOrWhiteSpace(Model.NewsTitle) && Model.NewsTitle != Model.Headline)
            {
                <h4 class="text-secondary fw-normal mb-4">@Model.NewsTitle</h4>
            }

            <div class="d-flex align-items-center gap-3 py-3 border-top border-bottom mb-4 text-muted small">
                <div>
                    <i class="bi bi-person-circle fs-5 me-1 text-primary"></i>
                    <span>Reported by: <strong>@(string.IsNullOrEmpty(Model.CreatedByName) ? "Staff Author" : Model.CreatedByName)</strong></span>
                </div>
                @if (!string.IsNullOrEmpty(Model.NewsSource) && Model.NewsSource != "N/A")
                {
                    <div>
                        <i class="bi bi-link-45deg fs-5 me-1"></i>
                        <span>Source: <strong>@Model.NewsSource</strong></span>
                    </div>
                }
            </div>

            <div class="article-content fs-5 lh-lg text-secondary mb-4" style="white-space: pre-line;">
                @Model.NewsContent
            </div>

            @if (Model.Tags != null && Model.Tags.Any())
            {
                <div class="pt-4 border-top">
                    <h6 class="fw-semibold text-muted text-uppercase small mb-2">Related Topics:</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill font-monospace small">
                                <i class="bi bi-hash text-primary"></i>@tag.TagName
                            </span>
                        }
                    </div>
                </div>
            }
        </article>
    </div>
</div>
