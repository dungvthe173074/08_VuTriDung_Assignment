@model IEnumerable<_08_VuTriDung_Assignment02_FrontEnd.Models.CategoryViewModel>
@{
    ViewData["Title"] = "Category Management";
    var currentSearch = ViewBag.CurrentSearch as string;
    var allCategories = ViewBag.AllCategories as List<_08_VuTriDung_Assignment02_FrontEnd.Models.CategoryViewModel> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">Category Management</h2>
        <p class="text-muted small mb-0">Organize and manage article categories and topics.</p>
    </div>
    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openCreateCategoryModal()">
        <i class="bi bi-folder-plus me-1"></i> Create Category
    </button>
</div>

<!-- Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Search categories by name or description..." value="@currentSearch" />
            </div>
            <button type="submit" class="btn btn-secondary rounded-pill px-4">Search</button>
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Clear">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    </div>
</div>

<!-- Categories Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small text-muted">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Parent Category</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-folder2-open fs-2 mb-2 d-block"></i>
                            No categories found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-muted">#@cat.CategoryID</td>
                            <td class="fw-semibold text-dark">@cat.CategoryName</td>
                            <td class="text-secondary small" style="max-width: 320px;">@cat.CategoryDesciption</td>
                            <td>
                                @if (cat.ParentCategoryID.HasValue && cat.ParentCategoryID.Value > 0)
                                {
                                    var parent = allCategories.FirstOrDefault(c => c.CategoryID == cat.ParentCategoryID.Value);
                                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small">
                                        <i class="bi bi-diagram-2 me-1 text-primary"></i>@(parent?.CategoryName ?? $"#{cat.ParentCategoryID}")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">None (Root)</span>
                                }
                            </td>
                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1.5 fw-medium">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1.5 fw-medium">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" onclick="openEditCategoryModal(@cat.CategoryID)">
                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="confirmDeleteCategory(@cat.CategoryID, '@cat.CategoryName')">
                                    <i class="bi bi-trash3 me-1"></i>Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create / Edit Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-0 py-3 bg-light rounded-top-4">
                <h5 class="modal-title fw-bold" id="categoryModalTitle">Create Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="categoryModalAlert" class="alert alert-danger d-none" role="alert"></div>

                <form id="categoryForm">
                    <input type="hidden" id="modalCategoryId" name="CategoryID" value="0" />

                    <div class="mb-3">
                        <label for="modalCategoryName" class="form-label small fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control rounded-3" id="modalCategoryName" name="CategoryName" placeholder="e.g. Science & Technology" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalCategoryDesc" class="form-label small fw-semibold">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control rounded-3" id="modalCategoryDesc" name="CategoryDesciption" rows="3" placeholder="Category description..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="modalParentCategoryId" class="form-label small fw-semibold">Parent Category</label>
                        <select class="form-select rounded-3" id="modalParentCategoryId" name="ParentCategoryID">
                            <option value="">-- No Parent (Root Category) --</option>
                            @foreach (var c in allCategories)
                            {
                                <option value="@c.CategoryID">@c.CategoryName</option>
                            }
                        </select>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="modalIsActive" checked>
                        <label class="form-check-label small fw-semibold" for="modalIsActive">Is Active</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light rounded-bottom-4 py-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSaveCategory" onclick="submitCategoryForm()">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="saveCategorySpinner" role="status"></span>
                    Save Category
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reusable Delete Modal -->
<partial name="_DeleteConfirmModal" />

@section Scripts {
    <script>
        var categoryModal = new bootstrap.Modal(document.getElementById('categoryModal'));
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        var deleteTargetId = null;

        function openCreateCategoryModal() {
            $('#categoryModalAlert').addClass('d-none').text('');
            $('#categoryModalTitle').text('Create Category');
            $('#modalCategoryId').val(0);
            $('#modalCategoryName').val('');
            $('#modalCategoryDesc').val('');
            $('#modalParentCategoryId').val('');
            $('#modalIsActive').prop('checked', true);
            categoryModal.show();
        }

        function openEditCategoryModal(id) {
            $('#categoryModalAlert').addClass('d-none').text('');
            $('#categoryModalTitle').text('Edit Category #' + id);
            $('#modalCategoryId').val(id);

            $.get('/Categories/GetCategory/' + id, function (data) {
                $('#modalCategoryName').val(data.categoryName);
                $('#modalCategoryDesc').val(data.categoryDesciption);
                $('#modalParentCategoryId').val(data.parentCategoryID || '');
                $('#modalIsActive').prop('checked', data.isActive !== false);
                categoryModal.show();
            }).fail(function () {
                showToast('Failed to load category details.', false);
            });
        }

        function submitCategoryForm() {
            var id = parseInt($('#modalCategoryId').val()) || 0;
            var name = $('#modalCategoryName').val().trim();
            var desc = $('#modalCategoryDesc').val().trim();
            var parentId = $('#modalParentCategoryId').val();
            var isActive = $('#modalIsActive').is(':checked');

            if (!name || !desc) {
                $('#categoryModalAlert').removeClass('d-none').text('Please fill in Category Name and Description.');
                return;
            }

            var payload = {
                CategoryID: id,
                CategoryName: name,
                CategoryDesciption: desc,
                ParentCategoryID: parentId ? parseInt(parentId) : null,
                IsActive: isActive
            };

            $('#saveCategorySpinner').removeClass('d-none');
            $('#btnSaveCategory').prop('disabled', true);

            $.ajax({
                url: '/Categories/Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    $('#saveCategorySpinner').addClass('d-none');
                    $('#btnSaveCategory').prop('disabled', false);

                    if (res.success) {
                        categoryModal.hide();
                        showToast(res.message, true);
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        $('#categoryModalAlert').removeClass('d-none').text(res.message);
                    }
                },
                error: function (xhr) {
                    $('#saveCategorySpinner').addClass('d-none');
                    $('#btnSaveCategory').prop('disabled', false);
                    $('#categoryModalAlert').removeClass('d-none').text('Error saving category: ' + (xhr.responseText || 'Server error.'));
                }
            });
        }

        function confirmDeleteCategory(id, name) {
            deleteTargetId = id;
            $('#deleteModalAlert').addClass('d-none').text('');
            $('#deleteModalMessage').html(`Are you sure you want to delete category <strong>${name}</strong> (ID: #${id})?`);
            deleteModal.show();
        }

        $('#btnConfirmDelete').on('click', function () {
            if (!deleteTargetId) return;

            $('#deleteSpinner').removeClass('d-none');
            $('#btnConfirmDelete').prop('disabled', true);

            $.ajax({
                url: '/Categories/Delete?id=' + deleteTargetId,
                type: 'POST',
                success: function (res) {
                    $('#deleteSpinner').addClass('d-none');
                    $('#btnConfirmDelete').prop('disabled', false);

                    if (res.success) {
                        deleteModal.hide();
                        showToast(res.message, true);
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        // Strict category constraint check error message!
                        $('#deleteModalAlert').removeClass('d-none').text(res.message);
                    }
                },
                error: function (xhr) {
                    $('#deleteSpinner').addClass('d-none');
                    $('#btnConfirmDelete').prop('disabled', false);
                    $('#deleteModalAlert').removeClass('d-none').text('Error deleting category: ' + (xhr.responseText || 'Server error.'));
                }
            });
        });
    </script>
}
