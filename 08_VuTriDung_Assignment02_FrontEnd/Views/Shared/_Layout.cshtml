@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNews Management System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-custom {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #38bdf8 !important;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .nav-link {
            font-weight: 500;
            color: #cbd5e1 !important;
            transition: all 0.2s ease;
            border-radius: 6px;
            padding: 6px 12px !important;
        }
        .nav-link:hover, .nav-link.active {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.08);
        }
        .badge-role-admin {
            background-color: #ef4444;
            color: white;
        }
        .badge-role-staff {
            background-color: #0284c7;
            color: white;
        }
        .badge-role-lecturer {
            background-color: #10b981;
            color: white;
        }
        .content-wrapper {
            flex: 1;
            padding-top: 2rem;
            padding-bottom: 3rem;
        }
        .footer {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            font-size: 0.875rem;
            color: #64748b;
        }
        /* Toast Notification Container */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1090;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-2">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-newspaper"></i> FUNews System
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> News Feed
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Accounts" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Accounts Management
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Report" asp-action="Index">
                                    <i class="bi bi-bar-chart-line me-1"></i> Report Statistics
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Categories" asp-action="Index">
                                    <i class="bi bi-folder2-open me-1"></i> Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="NewsArticles" asp-action="Index">
                                    <i class="bi bi-card-text me-1"></i> News Articles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="NewsArticles" asp-action="History">
                                    <i class="bi bi-clock-history me-1"></i> My Articles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-circle me-1"></i> Profile
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Lecturer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-circle me-1"></i> Profile
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                            var badgeClass = role switch
                            {
                                "Admin" => "badge-role-admin",
                                "Staff" => "badge-role-staff",
                                "Lecturer" => "badge-role-lecturer",
                                _ => "bg-secondary text-white"
                            };

                            <div class="d-flex align-items-center gap-2 text-white">
                                <span class="badge @badgeClass rounded-pill px-2.5 py-1.5 font-monospace">@role</span>
                                <span class="fw-semibold small">@User.Identity.Name</span>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper container">
        <!-- Toast Notification Container -->
        <div class="toast-container" id="toastContainer"></div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-3 mt-auto">
        <div class="container text-center">
            <span>&copy; 2026 - FUNewsManagementSystem - PRN232 Assignment 02</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Global Toast Notification Helper
        function showToast(message, isSuccess = true) {
            var bgClass = isSuccess ? 'bg-success text-white' : 'bg-danger text-white';
            var icon = isSuccess ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
            var html = `
                <div class="toast align-items-center ${bgClass} border-0 shadow-lg mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body d-flex align-items-center gap-2">
                            <i class="bi ${icon} fs-5"></i>
                            <span>${message}</span>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;
            var $toast = $(html);
            $('#toastContainer').append($toast);
            var bsToast = new bootstrap.Toast($toast[0], { delay: 4000 });
            bsToast.show();
            $toast.on('hidden.bs.toast', function () {
                $(this).remove();
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
