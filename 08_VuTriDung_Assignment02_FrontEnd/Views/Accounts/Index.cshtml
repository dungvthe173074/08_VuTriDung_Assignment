@model IEnumerable<_08_VuTriDung_Assignment02_FrontEnd.Models.AccountViewModel>
@{
    ViewData["Title"] = "Account Management";
    var currentSearch = ViewBag.CurrentSearch as string;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">Account Management</h2>
        <p class="text-muted small mb-0">Manage staff and lecturer accounts in FUNewsManagementSystem.</p>
    </div>
    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openCreateAccountModal()">
        <i class="bi bi-person-plus-fill me-1"></i> Create New Account
    </button>
</div>

<!-- Search Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Search by name or email..." value="@currentSearch" />
            </div>
            <button type="submit" class="btn btn-secondary rounded-pill px-4">Search</button>
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Clear">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </form>
    </div>
</div>

<!-- Accounts Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small text-muted">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Role</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 mb-2 d-block"></i>
                            No accounts found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var acc in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-muted">#@acc.AccountID</td>
                            <td class="fw-semibold text-dark">@acc.AccountName</td>
                            <td>
                                <a href="mailto:@acc.AccountEmail" class="text-decoration-none text-secondary">
                                    <i class="bi bi-envelope me-1 text-muted"></i>@acc.AccountEmail
                                </a>
                            </td>
                            <td>
                                @if (acc.AccountRole == 1)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1.5 fw-medium">
                                        <i class="bi bi-person-gear me-1"></i>Staff
                                    </span>
                                }
                                else if (acc.AccountRole == 2)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1.5 fw-medium">
                                        <i class="bi bi-mortarboard me-1"></i>Lecturer
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-1.5">Other (@acc.AccountRole)</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1" onclick="openEditAccountModal(@acc.AccountID)">
                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="confirmDeleteAccount(@acc.AccountID, '@acc.AccountName')">
                                    <i class="bi bi-trash3 me-1"></i>Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create / Edit Account Modal -->
<div class="modal fade" id="accountModal" tabindex="-1" aria-labelledby="accountModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-0 py-3 bg-light rounded-top-4">
                <h5 class="modal-title fw-bold" id="accountModalTitle">Create New Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="accountModalAlert" class="alert alert-danger d-none" role="alert"></div>

                <form id="accountForm">
                    <input type="hidden" id="modalAccountId" name="AccountID" value="0" />

                    <div class="mb-3">
                        <label for="modalAccountName" class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control rounded-3" id="modalAccountName" name="AccountName" placeholder="e.g. John Doe" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalAccountEmail" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" class="form-control rounded-3" id="modalAccountEmail" name="AccountEmail" placeholder="e.g. jdoe@FUNewsManagement.org" required />
                    </div>

                    <div class="mb-3">
                        <label for="modalAccountRole" class="form-label small fw-semibold">Account Role <span class="text-danger">*</span></label>
                        <select class="form-select rounded-3" id="modalAccountRole" name="AccountRole" required>
                            <option value="1">Staff (Role 1)</option>
                            <option value="2">Lecturer (Role 2)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="modalAccountPassword" class="form-label small fw-semibold">
                            Password <span id="passwordRequiredStar" class="text-danger">*</span>
                        </label>
                        <input type="password" class="form-control rounded-3" id="modalAccountPassword" name="AccountPassword" placeholder="••••••••" />
                        <div class="form-text small text-muted" id="passwordHelpText">Minimum 2 characters.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light rounded-bottom-4 py-3">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSaveAccount" onclick="submitAccountForm()">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="saveAccountSpinner" role="status"></span>
                    Save Account
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reusable Delete Modal -->
<partial name="_DeleteConfirmModal" />

@section Scripts {
    <script>
        var accountModal = new bootstrap.Modal(document.getElementById('accountModal'));
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
        var deleteTargetId = null;

        function openCreateAccountModal() {
            $('#accountModalAlert').addClass('d-none').text('');
            $('#accountModalTitle').text('Create New Account');
            $('#modalAccountId').val(0);
            $('#modalAccountName').val('');
            $('#modalAccountEmail').val('');
            $('#modalAccountRole').val('1');
            $('#modalAccountPassword').val('@("@1")');
            $('#passwordRequiredStar').show();
            $('#passwordHelpText').text('Default password is set to @("@1").');
            accountModal.show();
        }

        function openEditAccountModal(id) {
            $('#accountModalAlert').addClass('d-none').text('');
            $('#accountModalTitle').text('Edit Account #' + id);
            $('#modalAccountId').val(id);
            $('#passwordRequiredStar').hide();
            $('#passwordHelpText').text('Leave blank to keep existing password.');

            $.get('/Accounts/GetAccount/' + id, function (data) {
                $('#modalAccountName').val(data.accountName);
                $('#modalAccountEmail').val(data.accountEmail);
                $('#modalAccountRole').val(data.accountRole);
                $('#modalAccountPassword').val('');
                accountModal.show();
            }).fail(function () {
                showToast('Failed to load account details.', false);
            });
        }

        function submitAccountForm() {
            var id = parseInt($('#modalAccountId').val()) || 0;
            var name = $('#modalAccountName').val().trim();
            var email = $('#modalAccountEmail').val().trim();
            var role = parseInt($('#modalAccountRole').val());
            var password = $('#modalAccountPassword').val();

            if (!name || !email) {
                $('#accountModalAlert').removeClass('d-none').text('Please fill in all required fields.');
                return;
            }

            var payload = {
                AccountID: id,
                AccountName: name,
                AccountEmail: email,
                AccountRole: role,
                AccountPassword: password
            };

            $('#saveAccountSpinner').removeClass('d-none');
            $('#btnSaveAccount').prop('disabled', true);

            $.ajax({
                url: '/Accounts/Save',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    $('#saveAccountSpinner').addClass('d-none');
                    $('#btnSaveAccount').prop('disabled', false);

                    if (res.success) {
                        accountModal.hide();
                        showToast(res.message, true);
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        $('#accountModalAlert').removeClass('d-none').text(res.message);
                    }
                },
                error: function (xhr) {
                    $('#saveAccountSpinner').addClass('d-none');
                    $('#btnSaveAccount').prop('disabled', false);
                    $('#accountModalAlert').removeClass('d-none').text('Error saving account: ' + (xhr.responseText || 'Internal Server Error'));
                }
            });
        }

        function confirmDeleteAccount(id, name) {
            deleteTargetId = id;
            $('#deleteModalAlert').addClass('d-none').text('');
            $('#deleteModalMessage').html(`Are you sure you want to delete account <strong>${name}</strong> (ID: #${id})?`);
            deleteModal.show();
        }

        $('#btnConfirmDelete').on('click', function () {
            if (!deleteTargetId) return;

            $('#deleteSpinner').removeClass('d-none');
            $('#btnConfirmDelete').prop('disabled', true);

            $.ajax({
                url: '/Accounts/Delete?id=' + deleteTargetId,
                type: 'POST',
                success: function (res) {
                    $('#deleteSpinner').addClass('d-none');
                    $('#btnConfirmDelete').prop('disabled', false);

                    if (res.success) {
                        deleteModal.hide();
                        showToast(res.message, true);
                        setTimeout(function () { location.reload(); }, 800);
                    } else {
                        // Strict constraint error message!
                        $('#deleteModalAlert').removeClass('d-none').text(res.message);
                    }
                },
                error: function (xhr) {
                    $('#deleteSpinner').addClass('d-none');
                    $('#btnConfirmDelete').prop('disabled', false);
                    $('#deleteModalAlert').removeClass('d-none').text('Error deleting account: ' + (xhr.responseText || 'Server error.'));
                }
            });
        });
    </script>
}
