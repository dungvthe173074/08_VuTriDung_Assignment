@model IEnumerable<_08_VuTriDung_Assignment02_FrontEnd.Models.NewsArticleViewModel>
@{
    ViewData["Title"] = "My Article History";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">My Article History</h2>
        <p class="text-muted small mb-0">Track all news articles authored by you.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Management
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small text-muted">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Headline & Title</th>
                    <th>Category</th>
                    <th>Created Date</th>
                    <th>Modified Date</th>
                    <th>Status</th>
                    <th class="text-end pe-4">View</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-clock-history fs-2 mb-2 d-block"></i>
                            You have not authored any news articles yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-muted">#@item.NewsArticleID</td>
                            <td style="max-width: 320px;">
                                <div class="fw-bold text-dark text-truncate">@item.Headline</div>
                                @if (!string.IsNullOrEmpty(item.NewsTitle) && item.NewsTitle != item.Headline)
                                {
                                    <div class="text-muted small text-truncate">@item.NewsTitle</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small">
                                    @(string.IsNullOrEmpty(item.CategoryName) ? "Uncategorized" : item.CategoryName)
                                </span>
                            </td>
                            <td class="small text-muted">
                                @(item.CreatedDate?.ToString("MMM dd, yyyy") ?? "N/A")
                            </td>
                            <td class="small text-muted">
                                @(item.ModifiedDate?.ToString("MMM dd, yyyy") ?? "N/A")
                            </td>
                            <td>
                                @if (item.NewsStatus == true)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 small fw-medium">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1 small fw-medium">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.NewsArticleID" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
