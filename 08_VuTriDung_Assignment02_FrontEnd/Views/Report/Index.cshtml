@model _08_VuTriDung_Assignment02_FrontEnd.Models.ReportFilterViewModel
@{
    ViewData["Title"] = "News Articles Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">News Articles Report</h2>
        <p class="text-muted small mb-0">Generate statistical reports on news articles created within a specified date period.</p>
    </div>
    @if (Model.Articles.Any())
    {
        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
    }
</div>

<!-- Date Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="StartDate" class="form-label small fw-semibold text-muted">Start Date</label>
                <input asp-for="StartDate" class="form-control rounded-3" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="EndDate" class="form-label small fw-semibold text-muted">End Date</label>
                <input asp-for="EndDate" class="form-control rounded-3" type="date" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1 shadow-sm">
                    <i class="bi bi-filter me-1"></i> Generate Report
                </button>
                @if (Model.StartDate.HasValue || Model.EndDate.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Reset Dates">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Summary Statistics Banner -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="bi bi-journal-check fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Articles</span>
                    <h3 class="fw-bold mb-0">@Model.Articles.Count</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-check2-circle fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Active Published</span>
                    <h3 class="fw-bold mb-0">@Model.Articles.Count(a => a.NewsStatus == true)</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-secondary bg-opacity-10 text-secondary rounded-3">
                    <i class="bi bi-calendar-range fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Filter Period</span>
                    <div class="fw-semibold small mt-1">
                        @(Model.StartDate?.ToString("MMM dd, yyyy") ?? "All Time") &mdash; @(Model.EndDate?.ToString("MMM dd, yyyy") ?? "Present")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Report Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small text-muted">
                <tr>
                    <th class="ps-4">#</th>
                    <th>Created Date (Desc)</th>
                    <th>Headline & Title</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Articles.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
                            No articles found for the selected period.
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    @foreach (var art in Model.Articles)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">@(index++)</td>
                            <td class="fw-semibold text-dark text-nowrap">
                                <i class="bi bi-clock me-1 text-muted"></i>@(art.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                            </td>
                            <td style="max-width: 300px;">
                                <div class="fw-bold text-dark text-truncate" title="@art.Headline">@art.Headline</div>
                                @if (!string.IsNullOrEmpty(art.NewsTitle) && art.NewsTitle != art.Headline)
                                {
                                    <div class="text-muted small text-truncate" title="@art.NewsTitle">@art.NewsTitle</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small">
                                    @(string.IsNullOrEmpty(art.CategoryName) ? "Uncategorized" : art.CategoryName)
                                </span>
                            </td>
                            <td class="small text-secondary">
                                <i class="bi bi-person me-1"></i>@(string.IsNullOrEmpty(art.CreatedByName) ? "ID: " + art.CreatedByID : art.CreatedByName)
                            </td>
                            <td>
                                @if (art.NewsStatus == true)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 small fw-medium">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2.5 py-1 small fw-medium">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@art.NewsArticleID" class="btn btn-outline-secondary btn-sm rounded-pill px-3" target="_blank">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>View
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
