@model _08_VuTriDung_Assignment02_FrontEnd.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 64px; height: 64px;">
                    <i class="bi bi-person-fill fs-2"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">My Profile</h3>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 font-monospace mt-1">@Model.RoleName</span>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
            }

            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" asp-for="AccountID" />
                <input type="hidden" asp-for="AccountRole" />
                <input type="hidden" asp-for="RoleName" />

                <div class="mb-3">
                    <label asp-for="AccountName" class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="AccountName" class="form-control rounded-3" placeholder="Your full name" required />
                    <span asp-validation-for="AccountName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AccountEmail" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="AccountEmail" class="form-control rounded-3" placeholder="Your email address" required />
                    <span asp-validation-for="AccountEmail" class="text-danger small"></span>
                </div>

                <div class="pt-3 border-top mt-4 mb-3">
                    <h6 class="fw-bold mb-1 text-muted text-uppercase" style="font-size: 0.75rem;">Change Password (Optional)</h6>
                    <p class="text-muted small mb-3">Leave blank if you do not want to change your password.</p>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-semibold">New Password</label>
                        <input asp-for="NewPassword" class="form-control rounded-3" placeholder="••••••••" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill fw-semibold shadow-sm mt-2">
                    <i class="bi bi-check2-circle me-1"></i> Update Profile
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
